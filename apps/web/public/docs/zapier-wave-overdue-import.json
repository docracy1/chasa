{
  "name": "Docstoc — Import overdue invoices from Wave",
  "description": "When a Wave invoice is overdue, POST to Docstoc API to draft a chase email.",
  "steps": [
    {
      "app": "Wave",
      "event": "invoice_overdue",
      "note": "Use Wave + Zapier or Make; filter invoices where status is overdue"
    },
    {
      "app": "Webhooks by Zapier",
      "action": "POST",
      "url": "https://api.chasa.io/api/v1/chase/draft",
      "headers": {
        "Authorization": "Bearer YOUR_DOCSTOC_API_KEY",
        "Content-Type": "application/json"
      },
      "body": {
        "client_name": "{{customer_name}}",
        "invoice_amount": "{{amount_due}}",
        "days_overdue": "{{days_overdue}}",
        "due_date": "{{due_date}}"
      }
    }
  ],
  "docs": "https://docstoc.io/docs/",
  "connector": "https://docstoc.io/app/connector"
}
