# Hashed Vite assets must NEVER SPA-fallback to HTML. A stale HTML referencing a retired hash
# (or a Bot Fight interstitial) would otherwise return text/html 200 for /assets/*.js — React
# never boots. Status 404 here wins when no real file matches.
/assets/*  /404.html  404

# SPA app shell (Vite builds to /app/)
/app/*  /app/index.html  200
/app  /app/  301

# Directory trailing-slash normalization only.
# Do NOT add `/path /path.html 200` rewrites — Cloudflare Pages pretty URLs
# already serve `path.html` at `/path`, and those rewrites cause 308 loops.
/tools  /tools/  301
/blog  /blog/  301
/features  /features/  301
/docs  /docs/  301
/free-templates  /free-templates/  301

# Dynamic fallback for blog posts not yet baked into a static directory (weekly-cron or
# admin-authored posts published since the last full site rebuild) — Cloudflare Pages resolves a
# real static asset/directory first, so this only fires for genuinely unmatched /blog/<slug>
# paths; blog-post.js reads the slug from the URL and fetches it from the API directly.
/blog/*  /blog/post.html  200

# Short, shareable marketplace URLs
/marketplace  /free-templates/  301
/submit  /free-templates/submit  301

# Outreach short links are handled by functions/go/[[code]].ts (logs open, then 302).
# These static redirects are a fallback if the Function is unavailable.
/go/dm  /?utm_source=outreach&utm_medium=dm&utm_campaign=dm  302
/go/li  /?utm_source=linkedin&utm_medium=social&utm_campaign=li  302
/go/x   /?utm_source=x&utm_medium=social&utm_campaign=x  302
/go/try /app/?utm_source=try&utm_medium=shortlink&utm_campaign=try  302
/go/templates  /free-templates/?utm_source=templates&utm_medium=shortlink&utm_campaign=templates  302

# Compliance pages consolidated under /compliance/ — preserve any indexing/link
# equity the old URLs picked up rather than letting them 404. Both the bare and
# trailing-slash forms go straight to the destination — chaining bare -> slash -> dest
# is what Search Console flags as a "Redirect error".
/compliance  /compliance/  301
/solutions  /compliance/  301
/solutions/  /compliance/  301
/solutions/soc2-evidence-automation  /compliance/soc2  301
/solutions/iso27001-evidence-automation  /compliance/iso27001  301
/use-cases/sox-evidence-automation  /compliance/sox  301

/*  /404.html  404
