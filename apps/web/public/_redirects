# Hashed Vite assets must NEVER SPA-fallback to HTML. A stale HTML referencing a retired hash
# (or a Bot Fight interstitial) would otherwise return text/html 200 for /assets/*.js — React
# never boots. Status 404 here wins when no real file matches.
/assets/*  /404.html  404

# SPA app shell (Vite builds to /app/)
/app/*  /app/index.html  200
/app  /app/  301

# Directory trailing-slash normalization only.
# Do NOT add `/path /path.html 200` rewrites — Cloudflare Pages pretty URLs
# already serve `path.html` at `/path`, and those rewrites cause 308 loops.
/tools  /tools/  301
/blog  /blog/  301
/features  /features/  301
/docs  /docs/  301
/free-templates  /free-templates/  301

# Outreach short links are handled by functions/go/[[code]].ts (logs open, then 302).
# These static redirects are a fallback if the Function is unavailable.
/go/dm  /?utm_source=outreach&utm_medium=dm&utm_campaign=dm  302
/go/li  /?utm_source=linkedin&utm_medium=social&utm_campaign=li  302
/go/x   /?utm_source=x&utm_medium=social&utm_campaign=x  302
/go/try /app/?utm_source=try&utm_medium=shortlink&utm_campaign=try  302
/go/templates  /free-templates/?utm_source=templates&utm_medium=shortlink&utm_campaign=templates  302

